# Copy this file to `.env.local` and fill in your Supabase project values.
# Leave them blank to run Atlas in local mode (everything stored in this browser).
#
# Where to find these: Supabase dashboard -> your project -> Settings -> API
#   Project URL  ->  VITE_SUPABASE_URL
#   anon public  ->  VITE_SUPABASE_ANON_KEY
#
# The anon key is safe to ship in a static site: row level security is what
# actually protects the data, and every table in supabase/schema.sql has it on.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed when deploying to a GitHub Pages *project* site
# (https://<user>.github.io/<repo>/). Must start and end with a slash.
# VITE_BASE=/Atlas/
