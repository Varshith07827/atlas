# Copy this file to `.env.local` and fill in your Supabase project values.
# Leave them blank to run Atlas in local mode (everything stored in this browser).
#
# Where to find these: Supabase dashboard -> your project -> Project Settings
#   General  -> Project URL          ->  VITE_SUPABASE_URL
#   API Keys -> Publishable key      ->  VITE_SUPABASE_ANON_KEY
#                (sb_publishable_...)
#
# Older projects show a "Legacy anon, service_role API keys" tab instead; the
# "anon public" key there (a long eyJ... token) works too.
#
# Either one is safe to ship in a static site: it only identifies the project.
# Row level security is what actually protects the data, and every table in
# supabase/schema.sql has it switched on. Never use an sb_secret_... or
# service_role key here — those bypass every policy.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed when deploying to a GitHub Pages *project* site
# (https://<user>.github.io/<repo>/). Must start and end with a slash.
# VITE_BASE=/Atlas/
